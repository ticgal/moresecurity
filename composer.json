{
	"name": "ticgal/moresecurity",
	"description": "More Security plugin for GLPI",
	"license": "AGPL-3.0-or-later",
	"require": {
		"geoip2/geoip2": "^3.1",
		"league/iso3166": "^4.3"
	},
	"config": {
		"optimize-autoloader": true,
		"platform": {
			"php": "8.2.0"
		},
		"sort-packages": true,
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	},
	"require-dev": {
		"glpi-project/tools": "^0.7.5",
		"squizlabs/php_codesniffer": "^3.7"
	}
}
