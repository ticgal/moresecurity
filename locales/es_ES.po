#: hook.php
msgid "Login from your location is not permitted."
msgstr "No se permite iniciar sesión desde su ubicación."

#: hook.php
msgid "Too many failed login attempts from your IP. Please try again later."
msgstr ""
"Demasiados intentos fallidos de inicio de sesión desde su IP. Vuelva a "
