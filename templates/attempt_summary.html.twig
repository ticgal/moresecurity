<div class="table-responsive">
   <table class="table table-hover card-table">
      <thead>
         <tr>
            <th>{{ __('Type', 'moresecurity') }}</th>
            <th>{{ __('Login') }}</th>
            <th>{{ _n('Email', 'Emails', 1) }}</th>
            <th>{{ __('User') }}</th>
            <th>{{ __('IP') }}</th>
            <th>{{ __('Country', 'moresecurity') }}</th>
            <th>{{ __('Attempts') }}</th>
            <th>{{ __('Last attempt') }}</th>
         </tr>
      </thead>
      <tbody>
      {% for row in rows %}
         <tr>
            <td>{{ row.type }}</td>
            <td>{{ row.login }}</td>
            <td>{{ row.email }}</td>
            <td>{{ row.user|raw }}</td>
            <td>{{ row.ip }}</td>
            <td>{{ row.country }}</td>
            <td>{{ row.try_count }}</td>
            <td>{{ row.last_try }}</td>
         </tr>
      {% else %}
         <tr>
            <td colspan="8" class="text-center text-muted">{{ __('No item found') }}</td>
         </tr>
      {% endfor %}
      </tbody>
   </table>
</div>
