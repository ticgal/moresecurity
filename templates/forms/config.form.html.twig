{% import 'components/form/fields_macros.html.twig' as fields %}

{% if options is not defined %}
{% set options = {} %}
{% endif %}
{# buttons.html.twig reads `params` directly: define it for strict-variables environments #}
{% set params = params|default({}) %}

{% if api_login_unprotected %}
    <div class="alert alert-warning mb-3" role="alert" data-testid="ms-api-warning">
        <div class="d-flex">
            <i class="ti ti-alert-triangle fs-2 me-2"></i>
            <div>
                {{ __('The REST API is enabled with login by credentials: logins made through it are not limited, blocked, geoblocked or recorded by this plugin. Disable "Enable login with credentials" in Setup > General > API, or use API tokens and restrict the API clients by IP.', 'moresecurity') }}
            </div>
        </div>
    </div>
{% endif %}

{{ include('components/form/header.html.twig', {'in_twig': true, 'no_header': true}) }}

<div class="row">
    {# Login attempts #}
    <div class="row ps-4">
        <h3>{{ __("Login attempts", 'moresecurity') }}</h3>
        {{ fields.numberField(
            'number_attempts',
            item.fields['number_attempts'],
            __("Number of attempts", 'moresecurity'),
            options|merge({
                'min': 0,
                'max': 100,
                'step': 1
            })
        ) }}
        {{ fields.dropdownTimestampField(
            'time_blocked',
            item.fields['time_blocked'],
            __("Access time blocked", 'moresecurity'),
            options|merge({
                'display_emptychoice': false,
            })
        ) }}
        {{ fields.dropdownTimestampField(
            'max_time_blocked',
            item.fields['max_time_blocked'],
            __("Max access time blocked (backoff cap)", 'moresecurity'),
            options|merge({
                'display_emptychoice': false,
            })
        ) }}
    </div>

    {# IP blocking #}
    <div class="row ps-4">
        <h3>{{ __("IP blocking", 'moresecurity') }}</h3>
        {{ fields.numberField(
            'ip_max_attempts',
            item.fields['ip_max_attempts'],
            __("Max attempts per IP", 'moresecurity'),
            options|merge({
                'min': 0,
                'max': 100,
                'step': 1
            })
        ) }}
        {{ fields.dropdownTimestampField(
            'ip_time_blocked',
            item.fields['ip_time_blocked'],
            __("IP block duration", 'moresecurity'),
            options|merge({
                'display_emptychoice': false,
            })
        ) }}
        {{ fields.dropdownTimestampField(
            'ip_max_time_blocked',
            item.fields['ip_max_time_blocked'],
            __("Max IP block duration (backoff cap)", 'moresecurity'),
            options|merge({
                'display_emptychoice': false,
            })
        ) }}
        {{ fields.numberField(
            'ip_threshold',
            item.fields['ip_threshold'],
            __("IP threshold (0 = disabled)", 'moresecurity'),
            options|merge({
                'min': 0,
                'max': 100,
                'step': 1
            })
        ) }}
    </div>

    {# Password reset #}
    <div class="row ps-4">
        <h3>{{ __("Password reset attempts", 'moresecurity') }}</h3>
        {{ fields.numberField(
            'attempts_reset',
            item.fields['attempts_reset'],
            __("Attempts for Password Reset", 'moresecurity'),
            options|merge({
                'min': 0,
                'max': 100,
                'step': 1
            })
        ) }}
        {{ fields.dropdownTimestampField(
            'time_reset',
            item.fields['time_reset'],
            __("Access time blocked for Password Reset", 'moresecurity'),
            options|merge({
                'display_emptychoice': false,
            })
        ) }}
    </div>

    {# Trusted reverse proxies #}
    <div class="row ps-4">
        <h3>{{ __("Trusted proxies", 'moresecurity') }}</h3>
        {{ fields.textField(
            'trusted_proxies',
            item.fields['trusted_proxies']|default(''),
            __("Trusted reverse proxy IPs", 'moresecurity'),
            options|merge({
                'helper': __("Comma-separated (e.g. 10.0.0.1,10.0.0.2). X-Forwarded-For is only honoured when the request comes from one of these.", 'moresecurity'),
            })
        ) }}
    </div>

    {# Geoblocking #}
    <div class="row ps-4" data-testid="ms-geoblocking-card">
        <h3>{{ __("Geoblocking", 'moresecurity') }}</h3>
        {{ fields.dropdownArrayField(
            'geoblock_mode',
            item.fields['geoblock_mode']|default('disabled'),
            {
                'disabled': __("Disabled", 'moresecurity'),
                'allow': __("Only allow these countries", 'moresecurity'),
                'deny': __("Block these countries", 'moresecurity'),
            },
            __("Mode", 'moresecurity'),
            options
        ) }}
        {# Sent empty so deselecting every country clears the list #}
        <input type="hidden" name="geoblock_countries[]" value="" />
        {{ fields.dropdownArrayField(
            'geoblock_countries',
            '',
            geoblock_country_choices,
            __("Countries", 'moresecurity'),
            options|merge({
                'multiple': true,
                'values': geoblock_countries_selected,
            })
        ) }}
        {% if not geoip_database_ready %}
            <p class="text-warning mt-2">
                {{ __("The GeoIP database has not been downloaded yet. It is fetched by the \"updatedb\" automatic action; until then geoblocking lets every login through.", 'moresecurity') }}
            </p>
        {% endif %}
        <p class="text-muted mt-2">
            {{ __("IP geolocation data by", 'moresecurity') }}
            <a href="https://db-ip.com" target="_blank" rel="noopener">DB-IP</a>
            ({{ __("CC BY 4.0", 'moresecurity') }})
        </p>
    </div>

</div>

{{ include('components/form/buttons.html.twig') }}

{% set blocked_sections = [
    {'key': 'accounts', 'type': 'account', 'field': 'login', 'title': __('Blocked accounts', 'moresecurity')},
    {'key': 'ips', 'type': 'ip', 'field': 'ip', 'title': __('Blocked IPs', 'moresecurity')},
    {'key': 'emails', 'type': 'email', 'field': 'email', 'title': __('Blocked password reset requests', 'moresecurity')},
] %}
{% set has_blocked = (blocked.accounts|default([])|length + blocked.ips|default([])|length + blocked.emails|default([])|length) > 0 %}
{% if has_blocked %}
<form method="post" action="{{ path('/plugins/moresecurity/front/config.form.php') }}" id="ms-active-blocks">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />
    {% for section in blocked_sections %}
        {% for row in blocked[section.key]|default([]) %}
            <input type="hidden" name="unblock_all_items[]" value="{{ section.type ~ '|' ~ row[section.field] }}" />
        {% endfor %}
    {% endfor %}

    <div class="d-flex justify-content-end gap-2 mt-4 mb-2">
        <button type="submit" name="unblock_selected" value="1" class="btn btn-outline-secondary btn-sm"
            data-confirm="{{ __('Unlock the selected rows?', 'moresecurity') }}"
            data-empty="{{ __('Select at least one row first.', 'moresecurity') }}">
            {{ __("Unlock selected", 'moresecurity') }}
        </button>
        <button type="submit" name="unblock_all" value="1" class="btn btn-outline-secondary btn-sm"
            data-confirm="{{ __('Unlock every currently blocked entry?', 'moresecurity') }}">
            {{ __("Unlock all", 'moresecurity') }}
        </button>
    </div>

    {% for section in blocked_sections %}
        {% set rows = blocked[section.key]|default([]) %}
        {% if rows|length > 0 %}
            <div class="row ps-4 mt-4">
                <h3>{{ section.title }}</h3>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th></th>
                            <th>{{ __('Name') }}</th>
                            <th>{{ __('Blocked until', 'moresecurity') }}</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for row in rows %}
                        <tr>
                            <td>
                                <input type="checkbox" class="form-check-input ms-unblock-checkbox"
                                       name="unblock_items[]" value="{{ section.type ~ '|' ~ row[section.field] }}" />
                            </td>
                            <td>{{ row[section.field] }}</td>
                            <td>{{ row.blocked }}</td>
                            <td class="text-end">
                                <button type="submit" name="unblock_item" value="{{ section.type ~ '|' ~ row[section.field] }}" class="btn btn-sm btn-outline-danger">
                                    <i class="ti ti-lock-open"></i>
                                    <span>{{ __('Unblock', 'moresecurity') }}</span>
                                </button>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    {% endfor %}
</form>
{% endif %}

<script>
    document.querySelectorAll('#ms-active-blocks button[data-confirm]').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
            var form = btn.closest('form');
            if (btn.dataset.empty && !form.querySelector('.ms-unblock-checkbox:checked')) {
                alert(btn.dataset.empty);
                e.preventDefault();
                return;
            }
            if (!confirm(btn.dataset.confirm)) {
                e.preventDefault();
            }
        });
    });
</script>
