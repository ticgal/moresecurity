{% import 'components/form/fields_macros.html.twig' as fields %}
{% import 'components/form/buttons.html.twig' as buttons %}

{% if options is not defined %}
{% set options = {} %}
{% endif %}
{# buttons.html.twig reads `params` directly: define it for strict-variables environments #}
{% set params = params|default({}) %}

{{ include('components/form/header.html.twig', {'in_twig': true, 'no_header': true}) }}

<div class="row">
    {# Login attempts #}
    <div class="row ps-4">
        <h3>{{ __("Login attempts", 'moresecurity') }}</h3>
        {{ fields.numberField(
            'number_attempts',
            item.fields['number_attempts'],
            __("Number of attempts", 'moresecurity'),
            options|merge({
                'min': 0,
                'max': 100,
                'step': 1
            })
        ) }}
        {{ fields.dropdownTimestampField(
            'time_blocked',
            item.fields['time_blocked'],
            __("Access time blocked", 'moresecurity'),
            options|merge({
                'display_emptychoice': false,
            })
        ) }}
        {{ fields.dropdownTimestampField(
            'max_time_blocked',
            item.fields['max_time_blocked'],
            __("Max access time blocked (backoff cap)", 'moresecurity'),
            options|merge({
                'display_emptychoice': false,
            })
        ) }}
    </div>

    {# IP blocking #}
    <div class="row ps-4">
        <h3>{{ __("IP blocking", 'moresecurity') }}</h3>
        {{ fields.numberField(
            'ip_max_attempts',
            item.fields['ip_max_attempts'],
            __("Max attempts per IP", 'moresecurity'),
            options|merge({
                'min': 0,
                'max': 100,
                'step': 1
            })
        ) }}
        {{ fields.dropdownTimestampField(
            'ip_time_blocked',
            item.fields['ip_time_blocked'],
            __("IP block duration", 'moresecurity'),
            options|merge({
                'display_emptychoice': false,
            })
        ) }}
        {{ fields.dropdownTimestampField(
            'ip_max_time_blocked',
            item.fields['ip_max_time_blocked'],
            __("Max IP block duration (backoff cap)", 'moresecurity'),
            options|merge({
                'display_emptychoice': false,
            })
        ) }}
        {{ fields.numberField(
            'ip_threshold',
            item.fields['ip_threshold'],
            __("IP threshold (0 = disabled)", 'moresecurity'),
            options|merge({
                'min': 0,
                'max': 100,
                'step': 1
            })
        ) }}
    </div>

    {# Password reset #}
    <div class="row ps-4">
        <h3>{{ __("Password reset attempts", 'moresecurity') }}</h3>
        {{ fields.numberField(
            'attempts_reset',
            item.fields['attempts_reset'],
            __("Attempts for Password Reset", 'moresecurity'),
            options|merge({
                'min': 0,
                'max': 100,
                'step': 1
            })
        ) }}
        {{ fields.dropdownTimestampField(
            'time_reset',
            item.fields['time_reset'],
            __("Access time blocked for Password Reset", 'moresecurity'),
            options|merge({
                'display_emptychoice': false,
            })
        ) }}
    </div>

</div>

{{ include('components/form/buttons.html.twig') }}

{% set blocked_sections = [
    {'key': 'accounts', 'type': 'account', 'field': 'login', 'title': __('Blocked accounts', 'moresecurity')},
    {'key': 'ips', 'type': 'ip', 'field': 'ip', 'title': __('Blocked IPs', 'moresecurity')},
    {'key': 'emails', 'type': 'email', 'field': 'email', 'title': __('Blocked password reset requests', 'moresecurity')},
] %}
{% for section in blocked_sections %}
    {% set rows = blocked[section.key]|default([]) %}
    {% if rows|length > 0 %}
        <div class="row ps-4 mt-4">
            <h3>{{ section.title }}</h3>
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>{{ __('Name') }}</th>
                        <th>{{ __('Blocked until', 'moresecurity') }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                {% for row in rows %}
                    <tr>
                        <td>{{ row[section.field] }}</td>
                        <td>{{ row.blocked }}</td>
                        <td class="text-end">
                            <form method="post" action="{{ path('/plugins/moresecurity/front/config.form.php') }}">
                                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />
                                <input type="hidden" name="unblock_type" value="{{ section.type }}" />
                                <input type="hidden" name="unblock_value" value="{{ row[section.field] }}" />
                                <button type="submit" name="unblock" value="1" class="btn btn-sm btn-outline-danger">
                                    <i class="ti ti-lock-open"></i>
                                    <span>{{ __('Unblock', 'moresecurity') }}</span>
                                </button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endfor %}
